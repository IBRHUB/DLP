<Window x:Class="DownloadWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DLP.UI.Controls"
        Title="DLP"
        Width="760"
        Height="736"
        MinWidth="760"
        MinHeight="736"
        MaxWidth="760"
        MaxHeight="736"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        AllowDrop="True"
        DragEnter="OnSourceDragEnter"
        Drop="OnSourceDragDrop">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DLP" />

        <Grid Grid.Row="1" Margin="28,18,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Height="22" Orientation="Horizontal">
                    <Path Width="14" Height="14" VerticalAlignment="Center" Data="{DynamicResource IconLink}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Source" />
                </StackPanel>

                <Grid Height="36" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="_urlBox"
                                 Style="{StaticResource DlpTextBoxStyle}"
                                 AllowDrop="True"
                                 KeyDown="OnSourceKeyDown"
                                 DragEnter="OnSourceDragEnter"
                                 Drop="OnSourceDragDrop" />
                        <TextBlock Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="Paste link here or drag &amp; drop"
                                   Visibility="{Binding Text, ElementName=_urlBox, Converter={StaticResource StringEmptyToVisibilityConverter}}" />
                    </Grid>
                    <Button x:Name="_linkButton"
                            Grid.Column="2"
                            Style="{StaticResource DlpIconButtonStyle}"
                            ToolTip="Read link details"
                            Click="ReadLinkDetails_Click">
                        <Path Width="15" Height="15" Data="{DynamicResource IconLink}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" />
                    </Button>
                </Grid>

                <Border Height="44" Margin="0,8,0,0" Background="{DynamicResource Layer1BackgroundBrush}">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="_detectedKindLabel" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="_detectedTitleLabel" Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="_detectedDurationLabel" Grid.Column="2" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="_previewButton"
                                Grid.Column="4"
                                Style="{StaticResource DlpButtonStyle}"
                                ToolTip="Open the source link in your browser"
                                Click="Preview_Click">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Path Width="13" Height="13" Margin="0,0,8,0" Data="{DynamicResource IconPlay}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" Text="Preview" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <StackPanel Height="22" Orientation="Horizontal">
                    <Path Width="14" Height="14" VerticalAlignment="Center" Data="{DynamicResource IconDownload}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Download as" />
                </StackPanel>
                <Grid Height="40" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:ActionBarToggleButton x:Name="_videoButton"
                                               Text="Video"
                                               IconPath="{DynamicResource IconVideo}"
                                               Click="Video_Click" />
                    <ui:ActionBarToggleButton x:Name="_audioButton"
                                               Grid.Column="2"
                                               Text="Audio"
                                               IconPath="{DynamicResource IconAudio}"
                                               Click="Audio_Click" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="4" Height="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Quality" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Format" />
                <ComboBox x:Name="_qualitySelect" Grid.Row="1" Style="{StaticResource DlpComboBoxStyle}" />
                <ComboBox x:Name="_formatSelect" Grid.Row="1" Grid.Column="2" Style="{StaticResource DlpComboBoxStyle}" />
            </Grid>

            <StackPanel Grid.Row="6">
                <StackPanel Height="22" Orientation="Horizontal">
                    <Path Width="14" Height="14" VerticalAlignment="Center" Data="{DynamicResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Options" />
                </StackPanel>
                <Border Height="90" Margin="0,6,0,0" Background="Transparent">
                    <Grid Margin="0,8,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Embed subtitles (if available)" />
                        <ToggleButton x:Name="_embedSubsSwitch" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DlpSwitchStyle}" />
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource ControlBorderBrush}" Opacity="0.55" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Include browser cookies" />
                        <ToggleButton x:Name="_cookiesSwitch" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DlpSwitchStyle}" Checked="CookiesSwitch_Changed" Unchecked="CookiesSwitch_Changed" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="8">
                <StackPanel Height="22" Orientation="Horizontal">
                    <Path Width="14" Height="14" VerticalAlignment="Center" Data="{DynamicResource IconFolder}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Save to" />
                </StackPanel>
                <Grid Height="36" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="108" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="_savePathBox" IsReadOnly="True" Style="{StaticResource DlpTextBoxStyle}" />
                    <Button x:Name="_browseButton" Grid.Column="2" Style="{StaticResource DlpButtonStyle}" Click="Browse_Click">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Path Width="14" Height="14" Margin="0,0,8,0" Data="{DynamicResource IconFolder}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="Browse" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <Button x:Name="_downloadButton" Grid.Row="10" Style="{StaticResource DlpPrimaryButtonStyle}" Click="Download_Click" Content="Download" />

            <Border Grid.Row="12" Height="60" Background="{DynamicResource Layer1BackgroundBrush}">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="_statusLabel" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="_progressValueLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="0%" />
                    <ProgressBar x:Name="_progressBar" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Maximum="100" Value="0" Style="{StaticResource DlpProgressBarStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Row="14" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="212" />
                </Grid.ColumnDefinitions>
                <Button x:Name="_settingsButton" Style="{StaticResource DlpIconButtonStyle}" ToolTip="Check DLP and yt-dlp updates" Click="Settings_Click">
                    <Path Width="15" Height="15" Data="{DynamicResource IconSettings}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" />
                </Button>
                <Path Grid.Column="2" Width="15" Height="15" VerticalAlignment="Center" Data="{DynamicResource IconTheme}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" ToolTip="Dark mode is enabled" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button x:Name="_cancelButton" Grid.Column="5" Visibility="Collapsed" Style="{StaticResource DlpButtonStyle}" Click="Cancel_Click" Content="Cancel" />
                <Button x:Name="_openLogButton" Grid.Column="5" Visibility="Collapsed" Style="{StaticResource DlpButtonStyle}" Click="OpenLog_Click" Content="Log" />
                <Button x:Name="_openFolderButton" Grid.Column="7" Style="{StaticResource DlpButtonStyle}" Click="OpenFolder_Click">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,10,0" Data="{DynamicResource IconFolder}" Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Text="Open downloads folder" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
